cc {
  set { _
    jbl_test1.c
    jbl_test2.c
    jbl_test3.c
    jbn_test1.c
    jbn_test2.c
    iwjser_test1.c
    iwjsreg_test1.c
  }
  ${CFLAGS_TESTS}
}

foreach {
  OBJ
  ${CC_OBJS}
  run {
    exec { ${CC} ${OBJ} ${LDFLAGS_TEST} -o %{${OBJ}} }
    consumes { ${LIBIOWOW_A} ${OBJ} }
    produces { %{${OBJ}} }
  }
}

if { ${IOWOW_RUN_TESTS}
  run {
    shell { ln -sf SS{data} CC{} }
    produces { CC{data} }
  }
  foreach {
    OBJ
    ${CC_OBJS}
    run {
      always
      shell { S{.autark/test_run.sh} %{${OBJ}} }
      consumes { %{${OBJ}} }
    }
  }
}